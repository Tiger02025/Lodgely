{
  "name": "Lodgely Mobile",
  "slug": "lodgely-mobile",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "automatic",
  "icon": "./src/assets/icon.png",
  "splash": {
    "image": "./src/assets/splash.png",
    "resizeMode": "contain",
      "backgroundColor": "#134E4A"
    },
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "assetBundlePatterns": ["**/*"],
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.lodgely.mobile"
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./src/assets/adaptive-icon.png",
      "backgroundColor": "#134E4A"
    },
    "package": "com.lodgely.mobile",
    "usesCleartextTraffic": true
  },
  "web": {
    "bundler": "metro",
    "output": "single",
    "publicPath": "/mobile"
  }
}
