// API base URL. The Nest API serves its routes at the root, so there is no
// /api suffix here. EXPO_PUBLIC_* variables are inlined at build time by Expo.
//   iOS simulator : http://localhost:3001
//   Android emu   : http://10.0.2.2:3001
//   Real device   : http://<your-lan-ip>:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8000
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
CLOUDINARY_CLOUD_NAME=lodgely
