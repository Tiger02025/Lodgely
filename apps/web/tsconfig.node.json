{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noEmitOnError": true,
    "lib": ["DOM", "DOMIterable", "ES2021"],
    "types": ["vite/client"]
  },
  "include": ["vite.config.ts"]
}
