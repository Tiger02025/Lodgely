{
  "name": "lodgely-web",
  "version": "1.0.0",
  "description": "Lodgely Admin Dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext .ts,.tsx",
